---
import { type Locale, ui } from "@/i18n/content";

interface Props {
	locale?: Locale;
}
const { locale = "es" } = Astro.props;
const copy = ui[locale].stack;
---

<section class="bg-warm-white px-4 py-16 sm:px-6 lg:px-8 2xl:px-14" aria-labelledby="stack-title">
	<div class="mx-auto grid w-full max-w-340 gap-8 rounded-[28px] bg-brand-peach p-8 text-charcoal sm:p-10 lg:grid-cols-[0.8fr_1.2fr] lg:items-center lg:p-12">
		<div>
			<p class="text-xs font-bold tracking-[0.18em] text-charcoal/70 uppercase">{copy.eyebrow}</p>
			<h2 id="stack-title" class="mt-3 font-heading text-3xl leading-tight font-bold sm:text-4xl">{copy.title}</h2>
		</div>
		<ul class="flex flex-wrap gap-2.5">
			{copy.items.map((item) => (
				<li class="rounded-full bg-white px-4 py-2 text-sm font-semibold text-charcoal">{item}</li>
			))}
		</ul>
	</div>
</section>
